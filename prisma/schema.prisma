// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  email    String  @unique
  name     String
  password String
  balance  Decimal @db.Decimal(20, 8)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Position    Position[]
  Transaction Transaction[]
}

model Position {
  id String @id @default(cuid())

  userId   String
  user     User    @relation(fields: [userId], references: [id])
  value    Decimal @db.Decimal(20, 8)
  btcPrice Decimal @db.Decimal(20, 8)
  btcQty   Decimal @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id String @id @default(cuid())

  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  value         Decimal  @db.Decimal(20, 8)
  balanceBefore Decimal  @db.Decimal(20, 8)
  balanceAfter  Decimal  @db.Decimal(20, 8)
  btcQty        Decimal? @db.Decimal(20, 8)
  btcPrice      Decimal? @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BtcPrice {
  id String @id @default(cuid())

  buy  Decimal @db.Decimal(20, 8)
  sell Decimal @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
